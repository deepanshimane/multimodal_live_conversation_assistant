# Copy this file to a new file named exactly ".env" (same folder) and fill in the values.
# NEVER commit .env. NEVER paste keys in chat groups or code.

# --- ElevenLabs (mandatory) ---
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_STT_REALTIME_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL_FAST=eleven_flash_v2_5
ELEVENLABS_TTS_MODEL_EXPRESSIVE=eleven_v3

# --- LLM used for fusion (pick ONE provider: anthropic or gemini) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_SMART=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- App ---
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
CONSENT_STORE_DIR=backend/data/consent
